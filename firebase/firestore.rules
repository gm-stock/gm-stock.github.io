rules_version = '2';

// ─────────────────────────────────────────────────────────────
// 재고관리 앱 Firestore 보안 규칙 (젠틀몬스터·템버린즈 공통)
//
// 누가 무엇을 할 수 있나
//  - 외부인(로그인 안 함, 또는 명단에 없는 계정): 아무것도 할 수 없음
//  - 매장 계정(stores 명단): 재고·출고요청 보기, 출고요청 만들기(검토중),
//    검토중인 출고요청의 수량·매장명 수정, 재고 수량 차감
//  - 담당자(admins 문서 role != "owner"): 위 + 출고요청 상태 변경(승인·반려·출고·취소)
//  - 최고관리자(admins 문서 role == "owner"): 전부
//
// 관리자 명단: admins/{이메일 소문자}, 필드 role ("owner" 또는 "manager")
// 매장 계정 명단: stores/{이메일 소문자}
// Apps Script 시트 동기화는 구글 계정(프로젝트 소유자) 인증으로 접속하므로 이 규칙의 영향을 받지 않는다.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 로그인·역할 ──
    function myEmail() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower() : "";
    }
    function adminDoc() {
      return /databases/$(database)/documents/admins/$(myEmail());
    }
    function isAdmin() {
      return myEmail() != "" && exists(adminDoc());
    }
    function isOwner() {
      return isAdmin() && get(adminDoc()).data.get("role", "") == "owner";
    }
    function isStore() {
      return myEmail() != "" && exists(/databases/$(database)/documents/stores/$(myEmail()));
    }
    // 매장 화면을 쓸 수 있는 사람: 매장 계정 + 관리자
    function isStaff() {
      return isStore() || isAdmin();
    }

    // ── 재고 수량만 바뀌는지 ──
    // 바뀐 칸이 quantity / options 뿐이어야 한다.
    // quantity가 바뀌었다면 숫자, options가 바뀌었다면 바뀌기 전후 모두 목록이고 옵션 개수가 같아야 한다.
    // (options가 비어 있는(null) 품목도 수량만 바꾸는 저장은 통과)
    function onlyQuantityChanged() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(["quantity", "options"])
        && (!changed.hasAny(["quantity"]) || request.resource.data.quantity is number)
        && (!changed.hasAny(["options"]) || optionCountKept());
    }
    function optionCountKept() {
      return resource.data.get("options", null) is list
        && request.resource.data.get("options", null) is list
        && request.resource.data.options.size() == resource.data.options.size();
    }

    // ── 재고 품목 ──
    match /items/{itemId} {
      allow read: if isStaff();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (isStaff() && onlyQuantityChanged());
    }

    // ── 출고요청 ──
    match /orders/{orderId} {
      allow read: if isStaff();

      // 매장 계정·담당자는 검토중 상태로만 만들 수 있다. 최고관리자는 엑셀 일괄 발주 등으로 자유롭게.
      allow create: if isOwner()
        || (isStaff() && request.resource.data.get("status", "") == "검토중");

      // 매장 계정: 검토중인 요청의 수량(items)·매장명만, 상태는 그대로.
      //   (매장 화면은 문서 전체를 다시 저장하면서 id 칸을 함께 넣으므로 id도 허용)
      // 담당자·최고관리자: 상태 변경 포함 자유롭게.
      allow update: if isAdmin()
        || (isStore()
            && resource.data.get("status", "") == "검토중"
            && request.resource.data.get("status", "") == "검토중"
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(["items", "storeName", "id"]));

      allow delete: if isOwner();
    }

    // ── 시즌 배송 내역 (관리자 '시즌 배송' 탭에서 엑셀로 등록) ──
    // 매장 화면은 이걸 읽어서 매장별 배송 품목·수량·접수 기한을 보여준다.
    match /shipments/{shipmentId} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    // ── 추가 매장 목록 + 엑셀에서 쓰는 이름(별칭) ──
    // 코드의 기본 매장 목록(STORE_LIST)에 더해, 관리자 화면 '매장 목록 관리'에서 추가한 매장.
    // 문서: name("매장명 _ 국가"), aliases(엑셀에서 쓰는 다른 이름 목록)
    match /storeNames/{storeId} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    // ── 배송 이슈 접수 (파손·불량·누락) ──
    // 매장 계정: 접수가 열린 시즌에 '검토중'으로만 만들 수 있고, 만든 뒤에는 고칠 수 없다.
    // 담당자·최고관리자: 처리 상태 변경(재발송 예정 등). 삭제는 최고관리자만.
    match /claims/{claimId} {
      allow read: if isStaff();
      allow create: if isOwner() || (isStaff() && validNewClaim());
      allow update: if isAdmin();
      allow delete: if isOwner();
    }
    function validNewClaim() {
      let d = request.resource.data;
      let ship = /databases/$(database)/documents/shipments/$(d.get("shipmentId", "-"));
      return d.keys().hasOnly(["shipmentId", "storeName", "itemId", "itemName", "optName", "collection",
                               "type", "reason", "qty", "shipped", "photos", "reporter", "status",
                               "date", "createdAt"])
        && d.get("status", "") == "검토중"
        && d.get("type", "") in ["파손", "불량", "누락"]
        && d.get("qty", 0) is int && d.qty >= 1
        && d.get("shipped", 0) is int && d.qty <= d.shipped
        && d.get("photos", []) is list && d.get("photos", []).size() <= 3
        && exists(ship) && get(ship).data.get("open", false) == true;
    }

    // ── 재고 변동 기록 (최고관리자의 수량 수정 시 기록) ──
    match /stockLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isOwner();
      allow update, delete: if false;
    }

    // ── 포장재 재고 (현재 앱 코드에서는 쓰지 않는 예전 데이터, 보존용) ──
    match /packaging/{packId} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // ── 발주자 전체 이름: 매장에서 발주할 때 함께 저장, 관리자만 읽기 ──
    // (출고요청 문서에는 일부를 *로 가린 이름 ordererMasked 만 들어간다)
    match /orderContacts/{orderId} {
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(["name", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow read: if isAdmin();
      allow update, delete: if isOwner();
    }

    // ── 매장 계정 명단: 본인 문서만 읽기 ──
    // 최고관리자는 관리자 화면 '계정 관리'에서 명단 보기·추가·삭제(아이디 교체)를 할 수 있다.
    match /stores/{email} {
      allow get: if (myEmail() != "" && myEmail() == email) || isOwner();
      allow list: if isOwner();
      allow create: if isOwner() && email == email.lower();
      allow delete: if isOwner();
      allow update: if false;
    }

    // ── 관리자 명단: 본인 문서만 읽기, 최고관리자는 명단 보기만 (수정은 Firebase 콘솔에서만) ──
    match /admins/{email} {
      allow get: if (myEmail() != "" && myEmail() == email) || isOwner();
      allow list: if isOwner();
      allow write: if false;
    }

    // 그 밖의 모든 경로는 차단
  }
}
